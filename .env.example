# 复制为 .env 后填写。未配 LLM_API_KEY 时程序仍可正常排盘，只是不产出解读。

# ── 模型（OpenAI 兼容协议，国内三家任选其一）──────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8
LLM_TIMEOUT=120

# ── 历法 ───────────────────────────────────────────────────────
# 晚子时（23:00–23:59）日柱流派：
#   2 = 日柱算当天（默认，与通行万年历一致）
#   1 = 日柱算次日
# 此设定会影响日柱，进而影响六神起法与旬空。
DAY_BOUNDARY_SECT=2

# ── 服务 ───────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
